# ===================================================
# DillKash Kashmir — Server Environment Configuration
# ===================================================

# MySQL Database Configuration (MySQL 8.0+)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=dillkash_kashmir

# JWT Authentication
JWT_SECRET=change_this_to_a_long_random_secure_string_in_production
JWT_EXPIRES_IN=7d

# Server & CORS Configuration
PORT=5000
# Single frontend origin (legacy — use CLIENT_URLS for multiple domains)
CLIENT_URL=http://localhost:5173
# Comma-separated list of allowed origins in production:
# CLIENT_URLS=https://dillkashkashmir.com,https://www.dillkashkashmir.com

# Initial Admin Credentials (used by npm run db:setup / npm run db:seed-admin)
ADMIN_EMAIL=admin@dillkash.pk
ADMIN_PASSWORD=Admin@12345
ADMIN_NAME=Admin
ADMIN_PHONE=03001234567

# ── Cloudinary (Media Storage) ──────────────────────────────────────
# Sign up at https://cloudinary.com — get these from Dashboard → Settings → API Keys
# Images  : JPG, PNG, WebP, HEIC/HEIF are uploaded and auto-converted by Cloudinary
# Videos  : MP4, MOV, WebM short clips (≤20 MB) are stored under dillkash/videos/
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
